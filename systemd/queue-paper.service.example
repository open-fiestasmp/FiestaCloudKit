[Unit]
Description=Paper queue server
After=network-online.target
Wants=network-online.target

[Service]
User=mcqueue
Group=mcqueue
WorkingDirectory=/srv/mc-queue
ExecStart=/usr/bin/java -Xms128M -Xmx512M -XX:ActiveProcessorCount=1 -jar server.jar --nogui
Restart=on-failure
RestartSec=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mc-queue
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
